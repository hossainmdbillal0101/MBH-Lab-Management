rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null && (request.auth.token.staff == true || request.auth.token.admin == true); }
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    function text(v,n) { return v is string && v.size()>0 && v.size()<=n; }
    function date(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    match /labs/{id} {
      allow read: if staff();
      allow create,update: if admin() && request.resource.data.keys().hasAll(['name','location'])
        && request.resource.data.keys().hasOnly(['name','location'])
        && text(request.resource.data.name,100) && text(request.resource.data.location,200);
      allow delete: if false;
    }
    match /assets/{id} {
      allow read: if staff();
      allow create,update: if admin() && request.resource.data.keys().hasAll(['tag','name','labId','model','os','status','due','monitorTag'])
        && request.resource.data.keys().hasOnly(['tag','name','labId','model','os','status','due','monitorTag'])
        && request.resource.data.tag == id && id.matches('^[A-Z0-9_-]{3,80}$')
        && text(request.resource.data.name,150) && text(request.resource.data.model,150)
        && text(request.resource.data.os,150) && text(request.resource.data.monitorTag,150)
        && request.resource.data.status in ['Ready','Attention','In service'] && date(request.resource.data.due)
        && exists(/databases/$(database)/documents/labs/$(request.resource.data.labId));
      allow delete: if false;
    }
    match /inspections/{id} {
      allow read: if staff();
      allow create: if admin() && request.resource.data.keys().hasAll(['assetId','date','phase','results','notes','technician','outcome','nextDue'])
        && request.resource.data.keys().hasOnly(['assetId','date','phase','results','notes','technician','outcome','nextDue'])
        && request.resource.data.technician == request.auth.uid
        && request.resource.data.phase in ['Routine','Follow-up','Annual']
        && request.resource.data.results is list && request.resource.data.results.size()==9
        && request.resource.data.results.hasOnly(['Pass','Issue','Not applicable'])
        && request.resource.data.notes is string && request.resource.data.notes.size()<=2000
        && date(request.resource.data.date) && date(request.resource.data.nextDue)
        && exists(/databases/$(database)/documents/assets/$(request.resource.data.assetId))
        && request.resource.data.outcome == (request.resource.data.results.hasAny(['Issue'])?'Attention':'Ready')
        && getAfter(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.status == request.resource.data.outcome
        && getAfter(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.due == request.resource.data.nextDue;
      allow update,delete: if false;
    }
    match /{document=**} { allow read,write: if false; }
  }
}
